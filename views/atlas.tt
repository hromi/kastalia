<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><% knot.knot_name %> :: atlas</title>
<% INCLUDE modules/graph_seo_head.tt %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{ --bg:#0a0e14; --ink:#e7ecf5; --dim:#7b8aa3; --accent:#5ec8e0; }
*{box-sizing:border-box;}
html,body{margin:0;height:100%;background:var(--bg);}
body{color:var(--ink);font-family:'Space Grotesk',system-ui,sans-serif;overflow-x:hidden;}
h1{text-align:center;font-weight:500;font-size:clamp(1.2rem,3.4vw,1.8rem);padding-top:2rem;margin:0;letter-spacing:.02em;}
.abstract{text-align:center;max-width:46ch;margin:.6rem auto 0;color:var(--dim);font-size:.92rem;}

.atlas{
	--r:min(34vw,280px);
	position:relative;
	width:calc(var(--r) * 2 + 180px);height:calc(var(--r) * 2 + 180px);
	max-width:94vw;max-height:94vw;
	margin:2.5rem auto 1rem;
}
.ring{position:absolute;inset:90px;border:1px dashed rgba(94,200,224,.25);border-radius:50%;}
.center{
	position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
	width:150px;text-align:center;z-index:2;
}
.center a{
	display:block;color:var(--bg);background:var(--accent);
	border-radius:50%;width:100px;height:100px;margin:0 auto .6rem;
	display:flex;align-items:center;justify-content:center;
	font-weight:700;font-size:.85rem;padding:.5rem;line-height:1.15;
	text-decoration:none;box-shadow:0 0 28px rgba(94,200,224,.45);
}
.orbit-item{
	position:absolute;top:50%;left:50%;width:150px;margin:-50px 0 0 -75px;
	text-align:center;
}
.orbit-item .pos{transform:rotate(calc(var(--a) * 1deg)) translate(var(--r)) rotate(calc(var(--a) * -1deg));}
.orbit-item a{
	display:inline-block;color:var(--ink);text-decoration:none;
	background:#141c29;border:1px solid #223049;border-radius:14px;
	padding:.55rem .7rem;font-size:.82rem;line-height:1.3;
	transition:border-color .2s ease,transform .2s ease;
}
.orbit-item a:hover{border-color:var(--accent);transform:scale(1.05);}

.more{text-align:center;margin-top:1rem;}
.more a{color:var(--dim);font-size:.85rem;}
.empty{text-align:center;color:var(--dim);font-style:italic;padding:3rem 0;}
.gn-breadcrumb{position:static;max-width:36rem;margin:.6rem auto 0;white-space:normal;opacity:.85;color:var(--dim);font-size:.8rem;display:block;text-align:center;}
.gn-breadcrumb a{color:var(--dim);}
.gn-breadcrumb a:hover{color:var(--accent);}
.gn-breadcrumb .gn-current{color:var(--ink);}
.gn-altpaths{position:static;max-width:none;text-align:center;color:var(--dim);font-size:.72rem;}
.gn-related{max-width:36rem;margin:1rem auto 3rem;padding:0 1rem;text-align:center;}
.gn-related-h{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--dim);}
.gn-related ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;}
.gn-related li{font-size:.82rem;color:var(--dim);background:#141c29;border:1px solid #223049;border-radius:999px;padding:.3rem .7rem;}
.gn-related em{font-style:normal;color:var(--accent);}
.gn-related a{color:var(--ink);}
</style>
</head>
<body>
<h1><% knot.knot_name.short_name %></h1>
<% if knot.knot_content %><p class="abstract"><% knot.knot_content.remove_html_tags %></p><% end %>
<% INCLUDE modules/graph_breadcrumb.tt %>

<% children = knot.knot_id.get_children %>
<% shown = children.size > 12 ? children.slice(0,11) : children %>
<% n = shown.size %>
<div class="atlas">
	<div class="ring"></div>
	<div class="center"><a href="/<% knot.knot_id %>.html"><% knot.knot_name.short_name | truncate(40) %></a></div>
	<% i = 0 %>
	<% FOREACH c IN shown %>
		<% angle = n ? (i * (360 / n)) : 0 %>
		<div class="orbit-item">
			<div class="pos" style="--a:<% angle %>">
				<a href="/<% c.knot_id %>.html"><% c.knot_name.short_name | truncate(42) %></a>
			</div>
		</div>
		<% i = i + 1 %>
	<% END %>
</div>
<% IF children.size > 12 %><div class="more"><a href="/<% knot.knot_id %>.semester">+ <% children.size - 11 %> more &rarr;</a></div><% END %>
<% IF !children.size %><div class="empty">this constellation has no stars yet</div><% END %>
<% INCLUDE modules/graph_related.tt gn_related_title="Cross-constellation links" %>
</body>
</html>
