<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><% knot.knot_name %> :: samizdat</title>
<% INCLUDE modules/graph_seo_head.tt %>
<style>
:root{ --paper:#eeeae0; --ink:#111; --red:#a3221f; }
*{box-sizing:border-box;}
html,body{margin:0;background:var(--paper);color:var(--ink);}
body{
	font-family:'Courier New',monospace;
	background-image:radial-gradient(rgba(0,0,0,.05) 1px, transparent 1px);
	background-size:3px 3px;
	padding:1.4rem 1rem 4rem;
}
header{max-width:640px;margin:0 auto 1.6rem;text-align:center;border-bottom:4px double var(--ink);padding-bottom:1rem;}
header h1{
	font-size:clamp(1.8rem,7vw,2.6rem);
	text-transform:uppercase;
	letter-spacing:.03em;
	margin:0 0 .3rem;
	transform:skewX(-2deg);
}
.stamp{
	display:inline-block;border:2px solid var(--red);color:var(--red);
	padding:.1em .5em;font-weight:bold;transform:rotate(-4deg);
	font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;
	margin-bottom:.5rem;
}
header .abstract{font-style:italic;font-size:.92rem;color:#333;}

main{max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:1.1rem;}
.clipping{
	background:#fff;
	border:1px solid #999;
	box-shadow:3px 3px 0 rgba(0,0,0,.18);
	padding:.9rem 1rem 1rem;
	position:relative;
}
.clipping::before{
	content:"";position:absolute;top:-1px;left:-1px;right:-1px;height:6px;
	background:repeating-linear-gradient(90deg, transparent 0 6px, rgba(0,0,0,.25) 6px 7px);
}
.dateline{font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--red);margin-bottom:.2rem;}
.headline{font-size:1.08rem;font-weight:bold;margin:0 0 .3rem;}
.headline a{color:var(--ink);text-decoration:none;}
.headline a:hover{text-decoration:underline;}
.excerpt{font-size:.9rem;color:#333;margin:0;column-gap:1rem;}
.empty{text-align:center;color:#555;font-style:italic;padding:3rem 0;}
footer{max-width:640px;margin:2rem auto 0;text-align:center;font-size:.72rem;color:#555;}
.gn-breadcrumb{position:static;max-width:none;white-space:normal;opacity:1;color:#555;font-family:'Courier New',monospace;font-size:.78rem;display:block;margin-top:.4rem;}
.gn-breadcrumb a{color:var(--red);}
.gn-breadcrumb .gn-current{color:var(--ink);}
.gn-altpaths{position:static;max-width:none;color:#777;font-size:.68rem;}
</style>
</head>
<body>
<header>
	<div class="stamp">refused</div>
	<h1><% knot.knot_name.short_name %></h1>
	<% if knot.knot_content %><p class="abstract"><% knot.knot_content.remove_html_tags %></p><% end %>
	<% INCLUDE modules/graph_breadcrumb.tt %>
</header>
<main>
<% feed = knot.knot_id.get_chronological('desc', 40) %>
<% FOREACH f IN feed %>
	<article class="clipping">
		<div class="dateline"><% if f.date %><% f.date %><% else %>undated<% end %></div>
		<h2 class="headline"><a href="/<% f.knot_id %>.html"><% f.knot_name.short_name %></a></h2>
		<% if f.knot_content %><p class="excerpt"><% f.knot_content.remove_html_tags | truncate(220) %></p><% end %>
	</article>
<% END %>
<% IF !feed.size %><div class="empty">nothing has been refused here yet</div><% END %>
</main>
<footer>samizdat &middot; copied by hand, passed from reader to reader</footer>
</body>
</html>
